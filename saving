  <script>
    const goals = {
      helmet: 12000,
      bike: 300000,
      mokela: 5000,
      cnd: 6000,
      drl: 1500,
      throttle: 3000,
      fog: 2000,
      exhaust: 6000,
      footrest: 7000
    };

    let savings = {
      helmet: parseFloat(localStorage.getItem('helmet_saved')) || 0,
      bike: parseFloat(localStorage.getItem('bike_saved')) || 0,
      mokela: parseFloat(localStorage.getItem('mokela_saved')) || 0,
      cnd: parseFloat(localStorage.getItem('cnd_saved')) || 0,
      drl: parseFloat(localStorage.getItem('drl_saved')) || 0,
      throttle: parseFloat(localStorage.getItem('throttle_saved')) || 0,
      fog: parseFloat(localStorage.getItem('fog_saved')) || 0,
      exhaust: parseFloat(localStorage.getItem('exhaust_saved')) || 0,
      footrest: parseFloat(localStorage.getItem('footrest_saved')) || 0
    };

    let historyData = {
      helmet: JSON.parse(localStorage.getItem('helmet_history')) || [],
      bike: JSON.parse(localStorage.getItem('bike_history')) || [],
      mokela: JSON.parse(localStorage.getItem('mokela_history')) || [],
      cnd: JSON.parse(localStorage.getItem('cnd_history')) || [],
      drl: JSON.parse(localStorage.getItem('drl_history')) || [],
      throttle: JSON.parse(localStorage.getItem('throttle_history')) || [],
      fog: JSON.parse(localStorage.getItem('fog_history')) || [],
      exhaust: JSON.parse(localStorage.getItem('exhaust_history')) || [],
      footrest: JSON.parse(localStorage.getItem('footrest_history')) || []
    };

    function updateUI() {
      for (let key in goals) {
        const current = savings[key];
        const target = goals[key];
        const remaining = Math.max(0, target - current);
        const percentage = Math.min(Math.round((current / target) * 100), 100);

        document.getElementById(`${key}-saved`).innerText = current.toLocaleString();
        document.getElementById(`${key}-remaining`).innerText = remaining.toLocaleString();
        document.getElementById(`${key}-percent`).innerText = `${percentage}%`;
        document.getElementById(`${key}-bar`).style.width = `${percentage}%`;

        // Render History
        const historyBox = document.getElementById(`${key}-history`);
        if (historyData[key].length === 0) {
          historyBox.innerHTML = '<span style="color: var(--text-sub);">No transactions yet.</span>';
        } else {
          historyBox.innerHTML = historyData[key].map(item => `
            <div class="history-item ${item.type}">
              <span>${item.type === 'add' ? '+ Added' : '- Subtracted'}: ৳${item.amount.toLocaleString()}</span>
              <span>${item.date}</span>
            </div>
          `).join('');
        }
      }
    }

    function updateAmount(type, isAddition) {
      const input = document.getElementById(`${type}-input`);
      const val = parseFloat(input.value);

      if (isNaN(val) || val <= 0) {
        alert("Please enter a valid amount!");
        return;
      }

      const now = new Date();
      const timeString = `${now.getDate()}/${now.getMonth() + 1} ${now.getHours()}:${now.getMinutes() < 10 ? '0' : ''}${now.getMinutes()}`;

      if (isAddition) {
        savings[type] += val;
        historyData[type].unshift({ type: 'add', amount: val, date: timeString });
      } else {
        savings[type] = Math.max(0, savings[type] - val);
        historyData[type].unshift({ type: 'sub', amount: val, date: timeString });
      }

      // Keep maximum 10 history items per card
      if (historyData[type].length > 10) historyData[type].pop();

      localStorage.setItem(`${type}_saved`, savings[type]);
      localStorage.setItem(`${type}_history`, JSON.stringify(historyData[type]));

      input.value = '';
      updateUI();
    }

    // Initial Load
    updateUI();
  </script>
