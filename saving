<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Dream Tracker</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-red: #ef4444;
      --accent-green: #22c55e;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    h1 {
      margin-bottom: 25px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      text-align: center;
      font-size: 1.8rem;
      color: #38bdf8;
    }

    .container {
      width: 100%;
      max-width: 500px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .card {
      background-color: var(--card-bg);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      border: 1px solid #334155;
    }

    .card-title {
      font-size: 1.2rem;
      font-weight: bold;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-title .tag {
      font-size: 0.8rem;
      background: #334155;
      padding: 4px 8px;
      border-radius: 6px;
      color: #38bdf8;
    }

    .amount-info {
      display: flex;
      justify-content: space-between;
      margin: 12px 0 6px 0;
      font-size: 0.9rem;
      color: var(--text-sub);
    }

    .remaining-info {
      font-size: 0.85rem;
      color: #38bdf8;
      margin-bottom: 10px;
      text-align: right;
    }

    .progress-bg {
      width: 100%;
      height: 14px;
      background-color: #334155;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 15px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #38bdf8, #22c55e);
      width: 0%;
      transition: width 0.4s ease;
      border-radius: 10px;
    }

    .input-group {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
    }

    input[type="number"] {
      flex: 1;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #475569;
      background: #0f172a;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
    }

    button {
      padding: 10px 15px;
      border-radius: 8px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    button:hover {
      opacity: 0.9;
    }

    .btn-add {
      background-color: var(--accent-green);
      color: #fff;
    }

    .btn-sub {
      background-color: var(--accent-red);
      color: #fff;
    }

    /* Details / History Styling */
    .history-box {
      background: #0f172a;
      border-radius: 8px;
      padding: 10px;
      max-height: 100px;
      overflow-y: auto;
      font-size: 0.8rem;
      border: 1px solid #334155;
    }

    .history-title {
      font-size: 0.8rem;
      color: var(--text-sub);
      margin-bottom: 5px;
      font-weight: bold;
    }

    .history-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
      padding-bottom: 2px;
      border-bottom: 1px dashed #334155;
    }

    .history-item.add { color: var(--accent-green); }
    .history-item.sub { color: var(--accent-red); }
  </style>
</head>
<body>

